# =============================================================================
# Agente de Atendimento da Lais Casa — modelo de variáveis de ambiente
#
# ESTE ARQUIVO É VERSIONADO. Ele nunca deve conter valor real de credencial.
#
#   cp .env.example .env      e preencha o .env — nunca este aqui.
#
# O `.env` está protegido pelo .gitignore. Este não está, e nem deve: ele vai
# para o git como molde. Os nomes são parecidos de propósito, o que torna fácil
# errar o arquivo — se você está colando uma senha e o nome tem "example", pare.
#
# A lista abaixo é o mínimo que o projeto usa hoje. Ela cresce conforme o mapa
# em wayfinder/ fecha decisões: canal de WhatsApp, Google Calendar e Maino ainda
# não têm variável aqui porque ainda não foram decididos.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. SUPABASE
#    Painel: https://supabase.com/dashboard
# -----------------------------------------------------------------------------

# Project Settings > General > Reference ID. Identificador público.
SUPABASE_PROJECT_REF=

# Região do projeto: us-east-1, sa-east-1, eu-central-1 ...
# Necessária porque o host do pooler não se deduz do project ref.
SUPABASE_REGION=

# Project Settings > API Keys > Publishable key (sb_publishable_...).
# Pública por design: roda no navegador. O que protege o dado é o RLS,
# não o sigilo dela.
SUPABASE_PUBLISHABLE_KEY=

# https://supabase.com/dashboard/account/tokens
# ATENÇÃO: token da CONTA — alcança todos os seus projetos Supabase, não só
# este. É a credencial mais perigosa deste arquivo.
SUPABASE_ACCESS_TOKEN=

# Project Settings > Database > Database password.
# Diferente da senha da sua conta Supabase.
SUPABASE_DB_PASSWORD=

# NÃO PREENCHER. A secret key (sb_secret_...) ignora RLS por completo e este
# projeto não a usa. Se ela parecer necessária, o modelo de acesso está errado.
# SUPABASE_SECRET_KEY=


# -----------------------------------------------------------------------------
# 2. BANCO DE DADOS
# -----------------------------------------------------------------------------

# String de conexão do Postgres do Supabase.
# A senha vai percent-encoded na URL ("!" vira "%21").
DATABASE_URL=


# -----------------------------------------------------------------------------
# 3. LLM — Gemini API da Google (AI Studio), TIER PAGO
#
#    Decisão registrada no ticket 017 do mapa. O tier PAGO importa e não é
#    detalhe de custo: no free tier a Google declara que usa os dados para
#    melhorar os produtos; no pago, declara que não usa. Conversa de cliente é
#    dado pessoal — free tier só com dado sintético.
#
#    Chave: https://aistudio.google.com/apikey
#
#    Modelo corrigido em 2026-08-12: `gemini-3-flash-preview` (escolha original
#    do ticket 017/008) foi aposentado pela Google em 2026-07-15. Substituto:
#    `gemini-3.6-flash` (COM PONTO — a API rejeita "gemini-3-6-flash").
#    `thinkingLevel: "low"` continua controlável nativamente nele.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
LLM_MODEL=gemini-3.6-flash


# -----------------------------------------------------------------------------
# 4. LLM — kie.ai (protótipo e fallback, NUNCA com dado real de cliente)
#
#    A kie.ai retém logs com parâmetros de entrada por 2 meses e não publica
#    DPA nem jurisdição de tratamento. Serve para prototipar com dado sintético
#    e como provedor de fallback. Deixe em branco se não for usar.
# -----------------------------------------------------------------------------
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai


# -----------------------------------------------------------------------------
# 5. APLICAÇÃO
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
