# Copiar para .env.local e preencher. O .env.local NÃO vai para o git.
#
# As duas variáveis são públicas por design (rodam no navegador). O que protege o
# dado é o RLS no Supabase, não o sigilo delas — ver ticket 035.

# https://<project-ref>.supabase.co  — o project ref é o SUPABASE_PROJECT_REF do .env da raiz
VITE_SUPABASE_URL=

# Project Settings > API Keys > Publishable key (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=
